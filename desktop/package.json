{
  "name": "admin-catalogo-ml-desktop",
  "productName": "Admin Catálogo — Mercado Limpio",
  "version": "1.0.0",
  "description": "App de escritorio para administrar precios del catálogo Mercado Limpio (ventana dedicada sobre el panel publicado en GitHub Pages)",
  "author": "Mercado Limpio Distribuidora",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/build-icon.js",
    "dist": "npm run icon && electron-builder",
    "release": "npm run icon && electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "ar.com.mercadolimpio.admin-catalogo",
    "productName": "Admin Catálogo — Mercado Limpio",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Admin Catálogo ML"
    },
    "publish": {
      "provider": "github",
      "owner": "pablosantamaria26",
      "repo": "admin-catalogo-ml",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
